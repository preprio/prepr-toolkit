---
import '../styles/globals.css';
import NavBar from '../components/NavBar.astro';
import PreprToolbar from '@preprio/toolkit/astro/components/PreprToolbar';
import PreprTrackingPixel from '@preprio/toolkit/astro/components/PreprTrackingPixel';
import { getToolbarProps } from '@preprio/toolkit/astro';
import { extractAccessToken } from '@preprio/toolkit';
import { PREPR_GRAPHQL_URL } from '../lib/prepr';
import { preprFeatures } from '../lib/prepr-features';

interface Props {
  title?: string;
}
const { title = 'Prepr Astro complete starter' } = Astro.props;

// The toolkit reads no env vars of its own — you decide what "preview" means.
// This starter uses Astro's built-in import.meta.env.DEV. getToolbarProps never
// throws, but wrap defensively for static/404 paths where headers() is absent.
const isPreview = import.meta.env.DEV;
let toolbarProps = null;
if (isPreview) {
  try {
    toolbarProps = await getToolbarProps(
      Astro.request.headers,
      PREPR_GRAPHQL_URL,
      preprFeatures
    );
  } catch (error) {
    console.error('Failed to fetch toolbar props:', error);
  }
}
const accessToken = extractAccessToken(PREPR_GRAPHQL_URL);
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <PreprTrackingPixel id={accessToken} />
  </head>
  <body>
    <NavBar />
    <slot />
    {isPreview && toolbarProps && (
      <PreprToolbar {...toolbarProps} options={{ features: preprFeatures }} />
    )}
  </body>
</html>
