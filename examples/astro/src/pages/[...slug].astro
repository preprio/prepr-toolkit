---
import Layout from '../layouts/Layout.astro';
import { prepr } from '../lib/prepr';
import { GetPageBySlugDocument } from '../gql/graphql';
import Hero from '../components/sections/Hero.astro';
import Feature from '../components/sections/Feature.astro';

const slug = Astro.params.slug ?? '/';

// personalize: true forwards the Prepr headers onPreprRequest set on this
// request, so the response carries this visitor's segment / A-B variant.
const { data } = await prepr.query(
  GetPageBySlugDocument,
  { slug },
  { personalize: true, event: Astro },
);

if (!data.Page) {
  return new Response('Not found', { status: 404 });
}

const page = data.Page;
---
<Layout title={page.title ?? 'Prepr Astro complete starter'}>
  <meta property="prepr:id" content={page._id} />
  {page.content.map(element => {
    if (element.__typename === 'Hero') return <Hero item={element} />;
    if (element.__typename === 'Feature') return <Feature item={element} />;
    return null;
  })}
</Layout>
