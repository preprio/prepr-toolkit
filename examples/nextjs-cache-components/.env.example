# Your Prepr GraphQL endpoint, including the access token.
# Find it in Prepr: Settings > Access tokens > GraphQL.
PREPR_GRAPHQL_URL=https://graphql.prepr.io/<your-access-token>

# The ID of the Prepr webhook pointing at /api/prepr/webhook; Prepr signs
# every request with it. Find it in Prepr: Settings > Webhooks.
PREPR_WEBHOOK_SECRET=<your-webhook-id>
