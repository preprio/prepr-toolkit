<section class="section" data-prepr-variant-key="<%= item._context && item._context.variant_key %>">
  <div class="container">
    <div class="section__body">
      <h1><%= item.heading %></h1>
      <p><%= item.sub_heading %></p>
      <a href="#" class="btn" data-prepr-variant-event>Find your car</a>
    </div>
    <div class="section__media"><img src="<%= item.image && item.image.url %>" alt="Hero image" /></div>
  </div>
</section>
