# Your Prepr GraphQL endpoint, including the access token.
# Find it in Prepr: Settings > Access tokens > GraphQL.
# PUBLIC_ prefix is required by SvelteKit for values reachable from the browser.
PUBLIC_PREPR_GRAPHQL_URL=https://graphql.prepr.io/<your-access-token>
# WARNING: PUBLIC_* values ship to the browser, so this token is visible to
# every visitor. Use a scoped read-only token with only the "Enable edit mode"
# and GraphQL read permissions — never a token with write access.
