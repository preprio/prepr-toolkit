{
  "name": "@preprio/toolkit",
  "version": "0.2.0-beta.1",
  "description": "Prepr personalization, A/B testing and preview toolkit for Next.js, Nuxt, Astro, SvelteKit and Express",
  "license": "Apache-2.0",
  "author": "Prepr B.V. (https://prepr.io)",
  "keywords": [
    "prepr",
    "cms",
    "headless-cms",
    "personalization",
    "ab-testing",
    "preview",
    "visual-editing",
    "nextjs",
    "nuxt",
    "astro",
    "sveltekit"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.17"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/preprio/prepr-toolkit.git",
    "directory": "packages/toolkit"
  },
  "homepage": "https://github.com/preprio/prepr-toolkit#readme",
  "bugs": "https://github.com/preprio/prepr-toolkit/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./nextjs": {
      "types": "./dist/nextjs/index.d.ts",
      "import": "./dist/nextjs/index.js",
      "require": "./dist/nextjs/index.cjs"
    },
    "./json-script": {
      "types": "./dist/json-script.d.ts",
      "import": "./dist/json-script.js",
      "require": "./dist/json-script.cjs"
    },
    "./nextjs/components": {
      "types": "./dist/nextjs/components.d.ts",
      "import": "./dist/nextjs/components.js",
      "require": "./dist/nextjs/components.cjs"
    },
    "./nextjs/image-loader": {
      "types": "./dist/nextjs/image-loader.d.ts",
      "import": "./dist/nextjs/image-loader.js",
      "require": "./dist/nextjs/image-loader.cjs"
    },
    "./astro": {
      "types": "./dist/astro/index.d.ts",
      "import": "./dist/astro/index.js",
      "require": "./dist/astro/index.cjs"
    },
    "./astro/components/*": "./src/astro/*.astro",
    "./sveltekit": {
      "types": "./dist/sveltekit/index.d.ts",
      "import": "./dist/sveltekit/index.js",
      "require": "./dist/sveltekit/index.cjs"
    },
    "./sveltekit/components/*": "./src/sveltekit/*.svelte",
    "./nuxt": {
      "types": "./dist/nuxt/index.d.ts",
      "import": "./dist/nuxt/index.js",
      "require": "./dist/nuxt/index.cjs"
    },
    "./nuxt/components/*": "./src/nuxt/*.vue"
  },
  "files": [
    "dist",
    "src/astro/*.astro",
    "src/sveltekit/*.svelte",
    "src/nuxt/*.vue"
  ],
  "scripts": {
    "gen:css": "node scripts/compile-css.mjs",
    "prebuild": "rm -rf dist && pnpm gen:css && node scripts/check-version.mjs",
    "pretest": "pnpm gen:css",
    "pretypecheck": "pnpm gen:css",
    "build": "tsup",
    "postbuild": "node scripts/check-exports.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/stega": "^1.1.0",
    "preact": "^10.29.7"
  },
  "peerDependencies": {
    "next": ">=13",
    "react": ">=17",
    "react-dom": ">=17",
    "svelte": ">=4",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "browserslist": "^4.28.7",
    "happy-dom": "^20.11.1",
    "lightningcss": "^1.33.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
