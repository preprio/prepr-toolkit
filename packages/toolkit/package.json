{
  "name": "@preprio/toolkit",
  "version": "1.0.0-rc.1",
  "description": "Prepr personalization, A/B testing and preview toolkit for React, Next.js, Nuxt, Astro, SvelteKit and Express",
  "license": "Apache-2.0",
  "author": "Prepr B.V. (https://prepr.io)",
  "keywords": [
    "prepr",
    "cms",
    "headless-cms",
    "personalization",
    "ab-testing",
    "preview",
    "visual-editing",
    "react",
    "nextjs",
    "nuxt",
    "astro",
    "sveltekit"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.17"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/preprio/prepr-toolkit.git",
    "directory": "packages/toolkit"
  },
  "homepage": "https://github.com/preprio/prepr-toolkit#readme",
  "bugs": "https://github.com/preprio/prepr-toolkit/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./react/components": {
      "import": {
        "types": "./dist/react/components.d.ts",
        "default": "./dist/react/components.js"
      },
      "require": {
        "types": "./dist/react/components.d.cts",
        "default": "./dist/react/components.cjs"
      }
    },
    "./nextjs": {
      "import": {
        "types": "./dist/nextjs/index.d.ts",
        "default": "./dist/nextjs/index.js"
      },
      "require": {
        "types": "./dist/nextjs/index.d.cts",
        "default": "./dist/nextjs/index.cjs"
      }
    },
    "./json-script": {
      "import": {
        "types": "./dist/json-script.d.ts",
        "default": "./dist/json-script.js"
      },
      "require": {
        "types": "./dist/json-script.d.cts",
        "default": "./dist/json-script.cjs"
      }
    },
    "./nextjs/components": {
      "import": {
        "types": "./dist/nextjs/components.d.ts",
        "default": "./dist/nextjs/components.js"
      },
      "require": {
        "types": "./dist/nextjs/components.d.cts",
        "default": "./dist/nextjs/components.cjs"
      }
    },
    "./nextjs/image-loader": {
      "import": {
        "types": "./dist/nextjs/image-loader.d.ts",
        "default": "./dist/nextjs/image-loader.js"
      },
      "require": {
        "types": "./dist/nextjs/image-loader.d.cts",
        "default": "./dist/nextjs/image-loader.cjs"
      }
    },
    "./nextjs/live": {
      "import": {
        "types": "./dist/nextjs/live.d.ts",
        "default": "./dist/nextjs/live.js"
      },
      "require": {
        "types": "./dist/nextjs/live.d.cts",
        "default": "./dist/nextjs/live.cjs"
      }
    },
    "./astro": {
      "import": {
        "types": "./dist/astro/index.d.ts",
        "default": "./dist/astro/index.js"
      },
      "require": {
        "types": "./dist/astro/index.d.cts",
        "default": "./dist/astro/index.cjs"
      }
    },
    "./astro/components/*": "./src/astro/*.astro",
    "./codegen": {
      "import": {
        "types": "./dist/codegen/index.d.ts",
        "default": "./dist/codegen/index.js"
      },
      "require": {
        "types": "./dist/codegen/index.d.cts",
        "default": "./dist/codegen/index.cjs"
      }
    },
    "./sveltekit": {
      "import": {
        "types": "./dist/sveltekit/index.d.ts",
        "default": "./dist/sveltekit/index.js"
      },
      "require": {
        "types": "./dist/sveltekit/index.d.cts",
        "default": "./dist/sveltekit/index.cjs"
      }
    },
    "./sveltekit/live": {
      "import": {
        "types": "./dist/sveltekit/live.d.ts",
        "default": "./dist/sveltekit/live.js"
      },
      "require": {
        "types": "./dist/sveltekit/live.d.cts",
        "default": "./dist/sveltekit/live.cjs"
      }
    },
    "./sveltekit/components/*": "./src/sveltekit/*.svelte",
    "./nuxt": {
      "import": {
        "types": "./dist/nuxt/index.d.ts",
        "default": "./dist/nuxt/index.js"
      },
      "require": {
        "types": "./dist/nuxt/index.d.cts",
        "default": "./dist/nuxt/index.cjs"
      }
    },
    "./nuxt/live": {
      "import": {
        "types": "./dist/nuxt/live.d.ts",
        "default": "./dist/nuxt/live.js"
      },
      "require": {
        "types": "./dist/nuxt/live.d.cts",
        "default": "./dist/nuxt/live.cjs"
      }
    },
    "./nuxt/components/*": "./src/nuxt/*.vue"
  },
  "files": [
    "dist",
    "src/astro/*.astro",
    "src/sveltekit/*.svelte",
    "src/nuxt/*.vue"
  ],
  "scripts": {
    "gen:css": "node scripts/compile-css.mjs",
    "prebuild": "rm -rf dist && pnpm gen:css && node scripts/check-version.mjs",
    "pretest": "pnpm gen:css",
    "pretypecheck": "pnpm gen:css",
    "build": "tsup",
    "postbuild": "node scripts/check-exports.mjs",
    "test": "vitest run",
    "test:e2e": "pnpm build && vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/stega": "^1.1.0",
    "preact": "^10.29.8"
  },
  "peerDependencies": {
    "graphql": ">=16",
    "next": ">=13",
    "react": ">=17",
    "react-dom": ">=17",
    "svelte": ">=5",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "graphql": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "browserslist": "^4.29.5",
    "graphql": "^16.14.2",
    "happy-dom": "^21.0.4",
    "lightningcss": "^1.33.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
