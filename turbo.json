{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        ".astro/**",
        ".output/**",
        ".nuxt/**"
      ]
    },
    "test": {},
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
