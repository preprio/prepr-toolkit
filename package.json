{
  "name": "prepr-toolkit",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo build --filter='./packages/*'",
    "test": "turbo test --filter='./packages/*'",
    "typecheck": "turbo typecheck --filter='./packages/*'",
    "lint": "eslint .",
    "build:examples": "turbo build --filter='./examples/*'",
    "typecheck:examples": "turbo typecheck --filter='./examples/*'",
    "check:all": "turbo build test typecheck && pnpm lint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9",
    "eslint-plugin-react": "^7",
    "eslint-plugin-react-hooks": "^5",
    "turbo": "^2.10.7",
    "typescript-eslint": "^8"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1",
      "postcss": ">=8.5.10",
      "js-yaml": ">=4.3.1 <5",
      "@babel/core": ">=7.29.6",
      "astro": ">=7.1.6",
      "nanoid": ">=3.3.18 <4",
      "sharp": ">=0.35.0",
      "fast-uri": "^3.1.5"
    }
  }
}
