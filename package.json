{
  "name": "prepr-toolkit",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo build --filter='./packages/*'",
    "test": "turbo test --filter='./packages/*'",
    "typecheck": "turbo typecheck --filter='./packages/*'",
    "build:examples": "turbo build --filter='./examples/*'",
    "typecheck:examples": "turbo typecheck --filter='./examples/*'",
    "check:all": "turbo build test typecheck"
  },
  "devDependencies": {
    "turbo": "^2.10.7"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1",
      "postcss": ">=8.5.10",
      "js-yaml": ">=4.2.0 <5",
      "@babel/core": ">=7.29.6",
      "astro": ">=7.1.6"
    }
  }
}
